---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { href: "/posts", label: "博客" },
  { href: "/projects", label: "项目" },
  { href: "/tools", label: "工具" },
  { href: "/methods", label: "方法" },
  { href: "/about", label: "关于" },
] as const;

const indexItems = [
  { href: "/archives", label: "归档" },
  { href: "/timeline", label: "时间线" },
  { href: "/tags", label: "标签" },
  { href: "/search", label: "搜索" },
] as const;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  跳到正文
</a>

<header class="app-layout flex flex-col items-stretch">
  <div
    id="top-nav-wrap"
    class:list={[
      "pt-4 pb-2 sm:pt-6 sm:pb-3",
      "relative w-full bg-background",
      "flex items-baseline justify-between sm:items-center",
    ]}
  >
    <a
      href="/"
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "mt-4 grid w-56 grid-cols-2 place-content-center gap-2",
          "[&>li>a]:block [&>li>a]:whitespace-nowrap [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
          "hidden",
          "sm:mt-0 sm:flex sm:w-auto sm:gap-x-4 sm:gap-y-0",
        ]}
      >
        {
          navItems.map(({ href, label }) => (
            <li>
              <a href={href} class:list={{ "active-nav": isActive(href) }}>
                {label}
              </a>
            </li>
          ))
        }
        {
          SITE.lightAndDarkMode && (
            <li class="col-span-2 flex items-center justify-center sm:col-span-1">
              <button
                id="theme-btn"
                class="focus-outline relative size-10 p-3 text-foreground/85 hover:[&>svg]:stroke-accent sm:size-7 sm:p-1"
                title="切换明暗模式"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
  <nav
    class="w-full overflow-x-auto border-b border-border pt-0 pb-3 text-xs text-foreground/55 sm:pb-4"
    aria-label="内容索引"
  >
    <ul class="flex min-w-max items-center justify-start gap-x-5 gap-y-2 sm:justify-end">
      {
        indexItems.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                "whitespace-nowrap decoration-dashed underline-offset-4 transition-colors hover:text-accent hover:underline",
                {
                  "text-accent underline decoration-solid decoration-1":
                    isActive(href),
                },
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "打开菜单" : "关闭菜单");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
