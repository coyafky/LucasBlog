---
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const segments = currentUrlPath.split("/").slice(1).filter(Boolean);

const routeLabels: Record<string, string> = {
  posts: "博客",
  projects: "项目",
  tools: "工具",
  methods: "方法",
  about: "关于",
  archives: "归档",
  timeline: "时间线",
  tags: "标签",
  search: "搜索",
};

const breadcrumbItems = (() => {
  if (segments[0] === "posts") {
    const pageNumber = Number(segments[1] || 1);
    return [
      {
        label: pageNumber > 1 ? `博客（第 ${pageNumber} 页）` : "博客",
      },
    ];
  }

  if (segments[0] === "tags") {
    const tagName = decodeURIComponent(segments[1] || "");
    const pageNumber = Number(segments[2] || 1);
    return [
      { label: "标签", href: "/tags/" },
      {
        label:
          pageNumber > 1 ? `${tagName}（第 ${pageNumber} 页）` : `${tagName}`,
      },
    ].filter(item => item.label);
  }

  return segments.map((segment, index) => ({
    label: routeLabels[segment] ?? decodeURIComponent(segment),
    href:
      index + 1 === segments.length
        ? undefined
        : `/${segments.slice(0, index + 1).join("/")}/`,
  }));
})();
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href="/" class="opacity-80">首页</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbItems.map((breadcrumb, index) =>
        index + 1 === breadcrumbItems.length ? (
          <li>
            <span
              class="opacity-75"
              aria-current="page"
            >
              {breadcrumb.label}
            </span>
          </li>
        ) : (
          <li>
            <a href={breadcrumb.href} class="opacity-70">
              {breadcrumb.label}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
