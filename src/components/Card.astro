---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, contentType, takeaway, status, ...props } = data;

const contentTypeLabels = {
  blog: "博客",
  project: "项目",
  tool: "工具",
  method: "方法",
} as const;

const statusLabels = {
  active: "进行中",
  done: "已完成",
  learning: "学习中",
  paused: "暂停",
} as const;
---

<li
  class="my-5 rounded-lg border border-border bg-background p-4 transition hover:border-accent/45 hover:bg-muted/20"
>
  <div class="mb-2 flex flex-wrap gap-2 text-xs">
    <span class="rounded-full border border-border bg-muted/40 px-2.5 py-0.5">
      {contentTypeLabels[contentType]}
    </span>
    {
      status && (
        <span class="rounded-full border border-border bg-muted/40 px-2.5 py-0.5">
          {statusLabels[status]}
        </span>
      )
    }
  </div>
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <Datetime {...props} />
  <p>{description}</p>
  {takeaway && <p class="mt-2 text-sm">核心收获：{takeaway}</p>}
  <a
    href={getPath(id, filePath)}
    class="mt-3 inline-block text-sm font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
  >
    查看说明 &rarr;
  </a>
</li>
