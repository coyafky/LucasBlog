---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection(
  "blog",
  ({ data }) => !data.draft && data.contentType === "tool"
);
const toolPosts = getSortedPosts(posts);

const tools = [
  ["Hermes Agent", "长期记忆、自动化任务、技能沉淀和多入口 Agent 操作层。"],
  ["Obsidian", "个人第二大脑，承载项目资料、方法论、周复盘和知识库。"],
  ["飞书 / Lark CLI", "把会议、文档、表格、任务和知识库接入自动化工作流。"],
  ["Codex / Claude Code", "用于代码实现、项目分析、工具链调研和工程化落地。"],
  ["OpenClaw", "用于理解多 Agent、渠道接入和企业协作中的 Agent 形态。"],
] as const;
---

<Layout title={`工具 | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="工具"
    pageDesc="我关注的不是单个工具有多酷，而是它们如何组合成稳定的工作流。"
  >
    <section class="grid gap-4 sm:grid-cols-2">
      {
        tools.map(([name, desc]) => (
          <article class="border border-border p-4">
            <h2 class="text-xl font-semibold text-accent">{name}</h2>
            <p class="mt-3">{desc}</p>
          </article>
        ))
      }
    </section>

    {
      toolPosts.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-semibold tracking-wide">工具文章</h2>
          <ul>
            {toolPosts.map(data => (
              <Card {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>
